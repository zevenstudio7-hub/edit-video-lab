{
  "name": "gemini-video-lab",
  "version": "0.1.0",
  "type": "module",
  "description": "Laboratorio de edición inteligente de video con Gemini y Remotion",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render GeminiVideoLab out/gemini-video-lab.mp4",
    "render:showcase": "remotion render LibraryShowcase out/library-showcase.mp4",
    "typecheck": "tsc --noEmit",
    "auth-test": "ts-node src/videoAnalysis/authTest.ts",
    "analyze-video": "ts-node src/videoAnalysis/runAnalysis.ts",
    "library": "remotion studio library/index.ts",
    "library:check": "node library/validate.mjs",
    "typecheck:library": "tsc --noEmit -p library/tsconfig.json"
  },
  "dependencies": {
