{
  "name": "gemini-video-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Laboratorio de edición inteligente de video con Gemini y Remotion",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render GeminiVideoLab out/gemini-video-lab.mp4",
    "render:showcase": "remotion render LibraryShowcase out/library-showcase.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.438",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.438"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "^5.9.3"
  },
  "sideEffects": [
    "*.css"
  ]
}
